{
  "name": "nav-wright",
  "version": "0.1.8",
  "type": "module",
  "description": "Renderer for vessels, navigation lights, and rules-of-the-road scenes — SVG profile, bearing and plan views, and an optional 3D view",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/nav-wright.git"
  },
  "homepage": "https://github.com/mark-brannan/nav-wright#readme",
  "bugs": {
    "url": "https://github.com/mark-brannan/nav-wright/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./benchy": {
      "types": "./dist/benchy.d.ts",
      "import": "./dist/benchy.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./style.css": "./dist/style.css",
    "./models/*": "./models/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "models",
    "MODELS.md"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts --base ./ --outDir ../playground-dist --emptyOutDir",
    "render": "npm run build:playground && node scripts/render-scenes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && cp src/style.css dist/style.css",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "models": "npm run build && node scripts/loft-hulls.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "colregs-engine": "^0.1.9"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.2.8",
    "three": ">=0.159"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "colregs": "github:mark-brannan/colregs#v0.3.6",
    "playwright": "^1.63.0",
    "prettier": "3.6.2",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
